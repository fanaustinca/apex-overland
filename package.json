{
  "name": "apex-overland",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "APEX OVERLAND: open-world offroad point-to-point racing in the browser",
  "scripts": {
    "dev": "vite --port 8951 --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 8952",
    "assets": "node tools/fetch-assets.mjs",
    "test": "npm run build && node tests/e2e.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "shots": "node tests/shots.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "peerjs": "^1.5.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/three": "^0.187.0",
    "meshoptimizer": "^1.3.0",
    "puppeteer": "^25.18.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "license": "MIT"
}
